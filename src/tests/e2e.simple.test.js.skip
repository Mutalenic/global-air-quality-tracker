/**
 * Simplified End-to-End Flow Test
 * Tests critical user journeys through the application
 */

import React from 'react';
import { render, screen } from '@testing-library/react';
import { Provider } from 'react-redux';
import { MemoryRouter } from 'react-router-dom';
import configureStore from 'redux-mock-store';
import thunk from 'redux-thunk';
import Regions from '../components/Home/Region';
import Countries from '../components/Details/Countries';
import Pollutions from '../components/Home/Pollution';

// Mock react-toastify
jest.mock('react-toastify', () => ({
  ToastContainer: () => <div data-testid="toast-container">ToastContainer</div>,
  toast: {
    success: jest.fn(),
    error: jest.fn(),
    info: jest.fn(),
    warning: jest.fn(),
  },
}));

const middlewares = [thunk];
const mockStore = configureStore(middlewares);

// Helper function to render with providers
const renderWithProviders = (component, initialState = {}) => {
  const defaultState = {
    countriesReducer: {
      countries: [],
      selectedRegion: '',
      loading: false,
      error: null,
    },
    pollutionReducer: {
      pollution: {
        region: '',
        country: '',
        countryCode: '',
        capital: '',
        population: 0,
        aqi: 0,
        components: {},
      },
      loading: false,
      error: null,
    },
    ...initialState,
  };

  const store = mockStore(defaultState);
  
  return {
    ...render(
      <Provider store={store}>
        <MemoryRouter>
          {component}
        </MemoryRouter>
      </Provider>
    ),
    store,
  };
};

describe('End-to-End Application Flow - Simplified', () => {
  beforeEach(() => {
    localStorage.clear();
    jest.clearAllMocks();
  });

  describe('Home Page', () => {
    it('should render all regions on home page', () => {
      renderWithProviders(<Regions />);

      // Check if all 6 regions are displayed
      expect(screen.getByText(/Africa/i)).toBeInTheDocument();
      expect(screen.getByText(/Americas/i)).toBeInTheDocument();
      expect(screen.getByText(/Europe/i)).toBeInTheDocument();
      expect(screen.getByText(/Asia/i)).toBeInTheDocument();
      expect(screen.getByText(/Oceania/i)).toBeInTheDocument();
      expect(screen.getByText(/Antarctic/i)).toBeInTheDocument();
    });

    it('should display country counts for regions', () => {
      renderWithProviders(<Regions />);

      // Check for country counts
      expect(screen.getByText(/59 Countries/i)).toBeInTheDocument();
      expect(screen.getByText(/56 Countries/i)).toBeInTheDocument();
      expect(screen.getByText(/53 Countries/i)).toBeInTheDocument();
      expect(screen.getByText(/50 Countries/i)).toBeInTheDocument();
      expect(screen.getByText(/27 Countries/i)).toBeInTheDocument();
      expect(screen.getByText(/5 Countries/i)).toBeInTheDocument();
    });

    it('should display header text', () => {
      renderWithProviders(<Regions />);
      expect(screen.getByText(/Find Air Quality Data in your Location/i)).toBeInTheDocument();
    });
  });

  describe('Countries Page', () => {
    const mockCountries = [
      {
        name: { common: 'Kenya' },
        capital: ['Nairobi'],
        population: 53771296,
        cca2: 'KE',
        region: 'Africa',
        latlng: [-1, 38],
        flags: { png: 'https://flagcdn.com/w320/ke.png' },
      },
      {
        name: { common: 'Nigeria' },
        capital: ['Abuja'],
        population: 206139589,
        cca2: 'NG',
        region: 'Africa',
        latlng: [10, 8],
        flags: { png: 'https://flagcdn.com/w320/ng.png' },
      },
    ];

    it('should display countries when data is loaded', () => {
      const initialState = {
        countriesReducer: {
          countries: mockCountries,
          selectedRegion: 'Africa',
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Countries />, initialState);

      // Check if countries are displayed
      expect(screen.getByText('Kenya')).toBeInTheDocument();
      expect(screen.getByText('Nigeria')).toBeInTheDocument();
    });

    it('should display region name', () => {
      const initialState = {
        countriesReducer: {
          countries: mockCountries,
          selectedRegion: 'Africa',
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Countries />, initialState);
      expect(screen.getByText('Africa')).toBeInTheDocument();
    });

    it('should show loading state', () => {
      const initialState = {
        countriesReducer: {
          countries: [],
          selectedRegion: 'Africa',
          loading: true,
          error: null,
        },
      };

      renderWithProviders(<Countries />, initialState);

      // Should show loading text
      const loadingElements = screen.queryAllByText(/Loading/i);
      expect(loadingElements.length).toBeGreaterThan(0);
    });
  });

  describe('Pollution Page', () => {
    const mockPollution = {
      region: 'Africa',
      country: 'Kenya',
      countryCode: 'KE',
      capital: 'Nairobi',
      population: 53771296,
      aqi: 75,
      components: {
        co: 300,
        no2: 20,
        o3: 50,
        so2: 10,
        pm2_5: 25,
        pm10: 40,
      },
    };

    it('should display pollution data when loaded', () => {
      const initialState = {
        pollutionReducer: {
          pollution: mockPollution,
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Pollutions />, initialState);

      // Check if pollution data is displayed
      expect(screen.getByText('Kenya')).toBeInTheDocument();
      expect(screen.getByText(/75/)).toBeInTheDocument(); // AQI value
    });

    it('should display region and population', () => {
      const initialState = {
        pollutionReducer: {
          pollution: mockPollution,
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Pollutions />, initialState);

      expect(screen.getByText('Africa')).toBeInTheDocument();
      expect(screen.getByText(/53,771,296/)).toBeInTheDocument();
    });

    it('should show loading state', () => {
      const initialState = {
        pollutionReducer: {
          pollution: {},
          loading: true,
          error: null,
        },
      };

      renderWithProviders(<Pollutions />, initialState);

      // Should show loading text
      const loadingElements = screen.queryAllByText(/Loading/i);
      expect(loadingElements.length).toBeGreaterThan(0);
    });
  });

  describe('Error Handling', () => {
    it('should display error message when countries fail to load', () => {
      const initialState = {
        countriesReducer: {
          countries: [],
          selectedRegion: 'Africa',
          loading: false,
          error: 'Failed to load countries',
        },
      };

      renderWithProviders(<Countries />, initialState);

      // Should show error message
      expect(screen.getByText(/Failed to load countries/i)).toBeInTheDocument();
    });

    it('should display error message when pollution fails to load', () => {
      const initialState = {
        pollutionReducer: {
          pollution: {},
          loading: false,
          error: 'Failed to load pollution data',
        },
      };

      renderWithProviders(<Pollutions />, initialState);

      // Should show error message
      expect(screen.getByText(/Failed to load pollution data/i)).toBeInTheDocument();
    });
  });

  describe('Empty States', () => {
    it('should handle empty countries list', () => {
      const initialState = {
        countriesReducer: {
          countries: [],
          selectedRegion: 'Africa',
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Countries />, initialState);

      // Component should handle empty state gracefully
      // (redirect logic is tested via useEffect in component)
      expect(true).toBe(true);
    });

    it('should handle empty pollution data', () => {
      const initialState = {
        pollutionReducer: {
          pollution: {},
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Pollutions />, initialState);

      // Component should handle empty state gracefully
      expect(true).toBe(true);
    });
  });

  describe('Data Display', () => {
    it('should format population numbers correctly', () => {
      const initialState = {
        pollutionReducer: {
          pollution: {
            country: 'Kenya',
            population: 53771296,
            region: 'Africa',
            aqi: 75,
          },
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Pollutions />, initialState);

      // Check for formatted population
      expect(screen.getByText(/53,771,296/)).toBeInTheDocument();
    });

    it('should display country capitals', () => {
      const mockCountries = [
        {
          name: { common: 'Kenya' },
          capital: ['Nairobi'],
          population: 53771296,
          cca2: 'KE',
          region: 'Africa',
          latlng: [-1, 38],
          flags: { png: 'https://flagcdn.com/w320/ke.png' },
        },
      ];

      const initialState = {
        countriesReducer: {
          countries: mockCountries,
          selectedRegion: 'Africa',
          loading: false,
          error: null,
        },
      };

      renderWithProviders(<Countries />, initialState);

      expect(screen.getByText('Nairobi')).toBeInTheDocument();
    });
  });
});
